# Copy this file to .env and adjust if your postgres configuration differs.
#
# DATABASE_URL is only needed when running the app directly on your machine
# (without Docker). Under docker compose the api service builds this URL from
# the POSTGRES_* values below, so leave it commented out unless you want to
# point the app at a local database.
# DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

# Used by docker compose to create the database and connect the app to it.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
