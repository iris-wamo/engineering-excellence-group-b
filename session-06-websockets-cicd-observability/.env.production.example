# Configuration for the local "production" release stack (compose.release.yaml, scripts/release.sh).
# Copy to .env.production (git-ignored, never copied into the image) and set real values:
#   cp .env.production.example .env.production
# In GitHub Actions the same keys come from the "production" environment's secrets instead.
ENVIRONMENT=production
API_PORT=8002

POSTGRES_USER=taskflow
POSTGRES_DB=taskflow
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must not be the dev default: Settings refuses to start outside development/testing.
JWT_SECRET_KEY=change-me

# Account the smoke test signs up and logs in with (scripts/smoke_test.py)
SMOKE_EMAIL=release-smoke@example.com
SMOKE_PASSWORD=change-me-smoke-password
