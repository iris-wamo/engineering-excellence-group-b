# Database credentials (used by Docker Compose and application)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# --- Connection URL for host commands (make seed, make migrate, make test) ---

# Option A: When running against Docker Compose DB (Docker maps DB to host port 5433)
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5433/taskflow

# Option B: When running against a local PostgreSQL server on host (default port 5432)
# DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

# --- JWT access tokens (authentication) ---
# Generate a strong value for anything other than local development:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# --- MongoDB connection settings for raw task imports ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=taskflow

# --- Redis (task events: Pub/Sub channel + Stream) ---
# Docker Compose maps Redis to host port 6379. Tests use database 15 of the same server.
REDIS_URL=redis://localhost:6379/0

# --- Celery background tasks (broker and results on their own Redis databases) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Celery Beat due-task reminders ---
DUE_REMINDER_WINDOW_DAYS=1
DUE_REMINDER_INTERVAL_SECONDS=60.0
DUE_REMINDER_DEDUP_HOURS=24
DUE_REMINDER_BATCH_SIZE=500

# --- Flower monitoring ---
FLOWER_PORT=5555
# Required by the Compose flower service (user:password); pick your own for anything shared
FLOWER_BASIC_AUTH=taskflow:change-me

