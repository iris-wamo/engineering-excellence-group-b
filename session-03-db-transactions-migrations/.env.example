# Copy this file to .env and adjust if your local postgres differs.
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow


# Local (non-Docker) run — host Postgres
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

